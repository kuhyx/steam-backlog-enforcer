{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "mock", "astro.config.mjs", "vitest.config.ts", ".astro/types.d.ts"],
  "exclude": ["dist"]
}
