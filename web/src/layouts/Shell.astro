---
// Every page: sidebar nav, top bar (commands, running jobs, health), the
// stale-server banner, and the one command palette + runner dialog pair.
// All live parts are custom elements registered by src/elements/shell.ts.
import '@kuhyx/web-ui/tokens.css'
import '../styles/theme.css'
import '../index.css'
import '../styles/app.css'
import '../styles/controls.css'
import '../styles/screens.css'
import '../styles/library.css'
import DevToken from '../components/DevToken.astro'
import { BUILD_STAMP } from '../lib/buildStamp'
import { NAV } from '../shell/nav'

interface Props {
  title: string
}
const { title } = Astro.props
const here = Astro.url.pathname.replace(/\/$/, '') || '/'
const isActive = (to: string) => (to === '/' ? here === '/' : here === to || here.startsWith(`${to}/`))
const href = (to: string) => (to === '/' ? '/' : `${to}/`)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <DevToken />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="sbe-build" content={BUILD_STAMP} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Steam Backlog Enforcer</title>
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <div class="shell">
      <aside class="sidebar">
        <div class="brand">
          <span class="brand-mark" aria-hidden="true"></span>
          <span>Backlog<br />Enforcer</span>
        </div>
        <nav aria-label="Sections">
          <ul class="nav">
            {
              NAV.map((n) => (
                <li>
                  <a
                    href={href(n.to)}
                    class={isActive(n.to) ? 'nav-link active' : 'nav-link'}
                    aria-current={isActive(n.to) ? 'page' : undefined}
                  >
                    <span>{n.label}</span>
                    <kbd aria-hidden="true">Alt {n.key}</kbd>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </aside>
      <div class="main-col">
        <header class="topbar">
          <button type="button" class="btn btn-ghost palette-btn" data-open-palette aria-keyshortcuts="Control+K">
            Commands <kbd>Ctrl K</kbd>
          </button>
          <job-indicator></job-indicator>
          <span class="grow"></span>
          <health-badges></health-badges>
        </header>
        <stale-banner></stale-banner>
        <main id="main" class="main" tabindex="-1">
          <slot />
        </main>
      </div>
    </div>
    <command-palette></command-palette>
    <runner-dialog></runner-dialog>
    <script>
      import '../elements/shell'
    </script>
  </body>
</html>
