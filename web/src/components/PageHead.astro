---
// Page title and optional subtitle (spoken only, textgate) plus action buttons
// (default slot). Was ui/Page.tsx PageHead.
interface Props {
  title: string
  sub?: string
}
const { title, sub } = Astro.props
const hasActions = Astro.slots.has('default')
---

<header class="page-head">
  <div>
    <h1 class="sr-only">{title}</h1>
    {sub && <p class="sr-only">{sub}</p>}
    {Astro.slots.has('sub') && <p class="sr-only"><slot name="sub" /></p>}
  </div>
  {hasActions && <div class="page-actions"><slot /></div>}
</header>
